{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "desktop",
  "description": "Desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "shell:default",
    "shell:allow-open",
    "window-state:default"
  ]
}